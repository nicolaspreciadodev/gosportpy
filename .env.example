# Archivo de ejemplo de variables de entorno para GoSport
# Renombra este archivo a .env y completa los valores correctos para despliegue

DEBUG=True
SECRET_KEY=tu_secret_key_super_segura
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://localhost

# Base de datos (PostgreSQL en Railway, SQLite local por defecto)
# DATABASE_URL=postgres://usuario:contraseña@servidor:5432/nombre_db

# Cloudinary - Almacenamiento persistente de imágenes (Requerido para Railway)
# Obtén estas credenciales en https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Configuración de Correo Electrónico (Requerido para Mails en Producción)
# Si lo omites en local, la consola de django imprimirá los correos (fallback backend console).
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# Wompi Pagos
# WOMPI_PUBLIC_KEY=pub_test_XXXXX
# WOMPI_PRIVATE_KEY=prv_test_XXXXX
# WOMPI_EVENTS_SECRET=test_events_XXXXX

MERCADOPAGO_ACCESS_TOKEN=TEST-111111111111-mock-access-token
MERCADOPAGO_PUBLIC_KEY=TEST-mock-public-key
